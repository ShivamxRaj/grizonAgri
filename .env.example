# ============================================
# GRIZON AGRI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Database ---
DATABASE_URL=postgresql+asyncpg://grizon:grizon_agri_2026@localhost:5432/grizon_agri
DATABASE_SYNC_URL=postgresql://grizon:grizon_agri_2026@localhost:5432/grizon_agri

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Sarvam AI (Voice STT/TTS) ---
SARVAM_API_KEY=your_sarvam_api_key_here

# --- LLM Providers ---
GROQ_API_KEY=your_groq_api_key_here
# GRIZON_MODEL_API_KEY=your_grizon_model_key_here

# --- Sentinel Hub (Satellite NDVI) ---
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret

# --- IMD Weather API ---
IMD_API_KEY=your_imd_api_key_here

# --- OpenWeatherMap (Weather Fallback) ---
OWM_API_KEY=your_openweathermap_api_key_here

# --- UPAg / Mandi API ---
UPAG_API_KEY=your_upag_api_key_here

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# --- App Config ---
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=your_jwt_secret_key_change_in_production
